# Copy this file to .env and fill in values. Never commit .env.

# Port the web app listens on
PORT=3000

# How often to `git pull` so House Tracker JSON updates show up (default 2 minutes)
GIT_PULL_INTERVAL_MS=120000

# Set to false to skip git pull (useful for local UI work)
# GIT_PULL_ENABLED=false

# Force the demo sample houses even if data/houses/ has files
# USE_SAMPLE_DATA=true

# Optional override for where house JSON is read from (default: data/houses)
# HOUSES_DIR=/absolute/path/to/houses

# Optional override for the ranking order file (default: data/rankings.json)
# RANKINGS_PATH=/absolute/path/to/rankings.json

# Optional override for not-interested / pending reactivation (default: data/interest.json)
# INTEREST_PATH=/absolute/path/to/interest.json

# Optional override for saved map areas (default: data/geofences.json)
# GEOFENCES_PATH=/absolute/path/to/geofences.json

# Optional override for school pins (default: data/schools.json; sample mode uses data/sample/schools.json)
# SCHOOLS_PATH=/absolute/path/to/schools.json

# SQLite file for House Survey questions + per-house answers (default: data/survey.db).
# On Coolify, point this at a persistent volume so visit notes survive redeploys.
# SURVEY_DB_PATH=/persist/survey.db

# Nominatim geocoding (used when a house has no photo). Results are cached in
# data/geocode-cache.json (gitignored). At most 1 request/second.
# NOMINATIM_USER_AGENT=HouseTracker/1.0 (https://github.com/Natedogg373/house-tracker; local house-hunting dashboard)
# GEOCODE_CACHE_PATH=/absolute/path/to/geocode-cache.json
# GEOCODE_PREFETCH=false

# House Tracker webhook. Add house POSTs { "input": "<zillow url or address>" }.
# Reactivate POSTs { "action": "reactivate", "slug": "<slug>", "input": "<zillow url or address>" }.
# Authorization is sent as the Authorization header, verbatim.
HOUSE_TRACKER_WEBHOOK_URL=
HOUSE_TRACKER_WEBHOOK_AUTH=
