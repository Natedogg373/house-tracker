# Copy this file to .env and fill in values. Never commit .env.

# Port the web app listens on
PORT=3000

# How often to `git pull` so House Tracker JSON updates show up (default 2 minutes)
GIT_PULL_INTERVAL_MS=120000

# Set to false to skip git pull (useful for local UI work)
# GIT_PULL_ENABLED=false

# Force the demo sample houses even if data/houses/ has files
# USE_SAMPLE_DATA=true

# Optional override for where house JSON is read from (default: data/houses)
# HOUSES_DIR=/absolute/path/to/houses

# Nominatim geocoding (used when a house has no photo). Results are cached in
# data/geocode-cache.json (gitignored). At most 1 request/second.
# NOMINATIM_USER_AGENT=HouseTracker/1.0 (https://github.com/Natedogg373/house-tracker; local house-hunting dashboard)
# GEOCODE_CACHE_PATH=/absolute/path/to/geocode-cache.json
# GEOCODE_PREFETCH=false

# House Tracker webhook — POST { "input": "<zillow url or address>" }
# Authorization is sent as the Authorization header, verbatim.
HOUSE_TRACKER_WEBHOOK_URL=
HOUSE_TRACKER_WEBHOOK_AUTH=
